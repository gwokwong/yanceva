# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
# 可选：端点单次输出 tokens 上限（DeepSeek=8192；OpenAI/百炼可不设）。
# 设置后 graphiti 的大 max_tokens 请求会按此钳制，避免 400。
# LLM_MAX_OUTPUT_TOKENS=8192

# ===== 图谱后端配置（Graphiti + Neo4j，取代原 Zep Cloud）=====
# docker-compose 部署时保持默认即可；本地源码运行可用 localhost
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ===== Embedding 配置（Graphiti 向量检索用；缺省回退到 LLM_* 端点）=====
# 选项A（零成本自托管，docker-compose 已内置 ollama 服务）：
#   docker exec mirofish-ollama ollama pull qwen3-embedding:0.6b
#   EMBEDDING_BASE_URL=http://localhost:11434/v1   （容器内部署用 http://ollama:11434/v1）
#   EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
# 选项B（阿里百炼 text-embedding-v4，质量更好无需自管）：
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIM=1024

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 平台订单/支付 =====
# 支付模式：dev（本地开发免费入队）/ stripe（生产）
PAYMENT_MODE=dev
# 生产环境必须删除下面这行（否则免费"支付"任意订单）！
ALLOW_DEV_PAYMENT=true
# STRIPE_API_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# PAYMENT_SUCCESS_URL=https://your-domain/orders?paid=1
#
# 推荐：Creem（MoR 平台，中国个人可开、无需海外公司、支付宝直提人民币，~4%+$0.40）
# 1. creem.io 注册 → 创建 Products（对应每条 SKU 定价）→ 记下 prod_xxx
# 2. 填入商品目录 backend/uploads/products/catalog.json 的 creem_product_id 字段
# 3. 配置：
# PAYMENT_MODE=creem
# CREEM_API_KEY=your_creem_api_key
# CREEM_WEBHOOK_SECRET=whsec_xxx
# 4. Creem 后台 webhook 指向 https://你的域名/api/orders/creem/webhook
# 运维查询全部订单的管理密钥（可选）
# ADMIN_KEY=change-me
# CORS 允许来源（生产建议锁定前端域名）
# CORS_ORIGINS=https://your-domain
# Worker 并发与轮询
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=5

# ===== 邮件通知（Resend，免费 100 封/天）=====
# 推演完成后自动发送交付通知邮件给客户
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=noreply@yanceva.com
