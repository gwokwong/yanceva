[Unit]
Description=Yanceva Order Worker
After=network.target yanceva-api.service
Requires=yanceva-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/yanceva/backend
Environment="UV_CACHE_DIR=/opt/yanceva/.uv-cache"
ExecStartPre=/home/ubuntu/.local/bin/uv sync --extra payments
ExecStart=/home/ubuntu/.local/bin/uv run python -m app.worker \
  --worker-id worker-main \
  --concurrency 1 \
  --poll-interval 5
Restart=always
RestartSec=10

# 防止 CPU 跑满
Nice=5

[Install]
WantedBy=multi-user.target
