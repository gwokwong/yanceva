[Unit]
Description=Yanceva API (Flask + gunicorn)
After=network.target docker.service
Requires=docker.service

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/yanceva/backend
Environment="UV_CACHE_DIR=/opt/yanceva/.uv-cache"
ExecStartPre=/home/ubuntu/.local/bin/uv sync --extra payments
ExecStart=/home/ubuntu/.local/bin/uv run gunicorn \
  -w 2 --threads 4 \
  -b 0.0.0.0:5001 \
  --access-logfile /opt/yanceva/backend/uploads/run/api-access.log \
  --error-logfile /opt/yanceva/backend/uploads/run/api-error.log \
  --timeout 300 \
  "app:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
